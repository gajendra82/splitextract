# /etc/split-extract/split-extract.env
#
# Copy to production:
#   sudo mkdir -p /etc/split-extract
#   sudo cp deploy/systemd/split-extract.env.example /etc/split-extract/split-extract.env
#   sudo chmod 640 /etc/split-extract/split-extract.env
#   sudo chown root:www-data /etc/split-extract/split-extract.env
#
# This file supplements (does not replace) /var/www/html/.env for API keys and
# cloud credentials. Reliability flags may live here or in /var/www/html/.env.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
MAX_CONCURRENT_REQUESTS=1
REQUEST_QUEUE_TIMEOUT=3600
REQUEST_STUCK_THRESHOLD_SECONDS=1800
MAX_PARALLEL_CALLS=3
MAX_TESSERACT_CONCURRENCY=2

# Heavy scanned-PDF protection (optional — changes OCR routing when enabled)
OCR_TESSERACT_CALL_TIMEOUT_ENABLED=false
TESSERACT_CALL_TIMEOUT_SECONDS=90
OCR_PAGE_FUTURE_TIMEOUT_SECONDS=300
OCR_CPU_STEAL_GUARD_ENABLED=false
OCR_CPU_STEAL_THRESHOLD_PERCENT=80

OCR_WATCHDOG_ENABLED=false
OCR_WATCHDOG_INTERVAL_SECONDS=30
OCR_WATCHDOG_STUCK_SECONDS=300

OCR_STRUCTURED_LOGGING_ENABLED=false
OCR_SEMAPHORE_LOGGING_ENABLED=false
OCR_THREADPOOL_LOGGING_ENABLED=false
OCR_TESSERACT_LOGGING_ENABLED=false

OCR_MID_EXECUTION_HEARTBEAT_ENABLED=false
OCR_HEARTBEAT_TICK_SECONDS=30
