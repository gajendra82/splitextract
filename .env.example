# =============================================================================
# split-extract environment template (no secrets)
# =============================================================================

# Vertex AI / Gemini
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=pod-ocr-502015
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=./credentials/your-service-account.json

VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash-lite
ENABLE_VISION_FALLBACK=true
USE_LOCAL_GEMINI_RATE_LIMITER=true
GEMINI_MAX_REQUESTS_PER_MINUTE=120
GEMINI_MAX_REQUESTS_PER_DAY=10000
MAX_PARALLEL_CALLS=3

# Server
HOST=0.0.0.0
PORT=8001
MAX_CONCURRENT_REQUESTS=1
REQUEST_QUEUE_TIMEOUT=3600
REQUEST_STUCK_THRESHOLD_SECONDS=1800
MAX_TESSERACT_CONCURRENCY=6
MAX_CONCURRENT_EXTRACTIONS=2
MAX_CONCURRENT_GEMINI_REQUESTS=2
SALES_EXTRACTION_QUEUE_TIMEOUT=3600

# OpenAI GPT (optional)
USE_GPT_FOR_GOOD_OCR=true
# OPENAI_API_KEY=
GPT_TEXT_MODEL=gpt-5.4-mini
GPT_TIMEOUT=45

# Azure Blob Storage (optional)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
AZURE_CONTAINER_NAME=invoice-splits
ROOT_FOLDER=POD

# Reliability (all OFF by default)
OCR_WATCHDOG_ENABLED=false
OCR_STRUCTURED_LOGGING_ENABLED=false
OCR_MID_EXECUTION_HEARTBEAT_ENABLED=false
OCR_TESSERACT_CALL_TIMEOUT_ENABLED=false

# Secondary-sales quality gate + paid Gemini Vision fallback
# (existing format parsers stay primary; Vision only when untrusted)
ENABLE_GEMINI_EXTRACTION_FALLBACK=true
SALES_STATEMENT_OCR_QUALITY_THRESHOLD=75
GEMINI_EXTRACTION_FALLBACK_MAX_ATTEMPTS=1
GEMINI_EXTRACTION_FALLBACK_MAX_PAGES=4
GEMINI_EXTRACTION_MIN_VALID_PRODUCT_ROWS=1
GEMINI_EXTRACTION_MAX_OCR_NOISE_PERCENT=30
GEMINI_EXTRACTION_MAX_IDENTITY_FAILURE_PERCENT=20
GEMINI_EXTRACTION_MIN_VALID_NUMERIC_PERCENT=70
