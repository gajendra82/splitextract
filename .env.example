############################################
# Gemini
############################################

GEMINI_API_KEY=your-gemini-api-key-here

############################################
# OpenAI GPT
############################################

USE_GPT_FOR_GOOD_OCR=true

OPENAI_API_KEY=your-openai-api-key-here

GPT_TEXT_MODEL=gpt-5.4-mini

GPT_TIMEOUT=45

############################################
# Azure Blob Storage
############################################

AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string-here
AZURE_STORAGE_ACCOUNT_NAME=your-account-name
AZURE_STORAGE_ACCOUNT_KEY=your-account-key
AZURE_CONTAINER_NAME=invoice-splits

############################################
# Server (optional)
############################################

HOST=0.0.0.0
PORT=8001
MAX_CONCURRENT_REQUESTS=1
REQUEST_QUEUE_TIMEOUT=3600
MAX_PARALLEL_CALLS=3
MAX_TESSERACT_CONCURRENCY=6
