# =============================================================================
# split-extract environment template (no secrets)
# =============================================================================

# Vertex AI / Gemini
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=pod-ocr-502015
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=./credentials/your-service-account.json

VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash-lite
ENABLE_VISION_FALLBACK=true
USE_LOCAL_GEMINI_RATE_LIMITER=true
GEMINI_MAX_REQUESTS_PER_MINUTE=120
GEMINI_MAX_REQUESTS_PER_DAY=10000
MAX_PARALLEL_CALLS=3

# Server
HOST=0.0.0.0
PORT=8001
MAX_CONCURRENT_REQUESTS=1
REQUEST_QUEUE_TIMEOUT=3600
REQUEST_STUCK_THRESHOLD_SECONDS=1800
MAX_TESSERACT_CONCURRENCY=6
MAX_CONCURRENT_EXTRACTIONS=2
MAX_CONCURRENT_GEMINI_REQUESTS=2
GEMINI_PROVIDER_429_COOLDOWN_SECONDS=30
GEMINI_PROVIDER_429_MAX_COOLDOWN_SECONDS=120
GEMINI_PROVIDER_429_MAX_RETRIES=3
SALES_EXTRACTION_QUEUE_TIMEOUT=3600
SALES_EXTRACTION_MAX_EXECUTION_SECONDS=600
SALES_TESSERACT_CALL_TIMEOUT_SECONDS=180
SALES_OCR_MAX_CALLS_PER_REQUEST=500
SALES_OCR_CACHE_MAX_ENTRIES=64
SALES_OCR_MAX_IMAGE_SIDE=4000
# Stock-statement OCR: initial pass plus this many targeted recoveries (default 1).
STOCK_OCR_MAX_RECOVERY_ATTEMPTS=1
# Direct original-image Gemini when structured stock OCR is unreliable.
STOCK_HEADER_CONFIDENCE_MIN=0.60
STOCK_MIN_NUMERIC_COVERAGE=0.50
STOCK_MAX_IDENTITY_FAILURE_RATE=0.25
STOCK_MIN_EXTRACTION_CONFIDENCE=0.60
STOCK_GEMINI_IMAGE_MAX_BYTES=12000000
SALES_PDF_MAX_PAGES=20

# OpenAI GPT (optional)
USE_GPT_FOR_GOOD_OCR=true
# OPENAI_API_KEY=
GPT_TEXT_MODEL=gpt-5.4-mini
GPT_TIMEOUT=45

# Azure Blob Storage (optional)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
AZURE_CONTAINER_NAME=invoice-splits
ROOT_FOLDER=POD

# Reliability (all OFF by default)
OCR_WATCHDOG_ENABLED=false
OCR_STRUCTURED_LOGGING_ENABLED=false
OCR_MID_EXECUTION_HEARTBEAT_ENABLED=false
OCR_TESSERACT_CALL_TIMEOUT_ENABLED=false

# Secondary-sales quality gate + paid Gemini Vision fallback
# (existing format parsers stay primary; Vision only when untrusted)
ENABLE_GEMINI_EXTRACTION_FALLBACK=true
SALES_STATEMENT_OCR_QUALITY_THRESHOLD=75
GEMINI_EXTRACTION_FALLBACK_MAX_ATTEMPTS=1
GEMINI_EXTRACTION_FALLBACK_MAX_PAGES=4
GEMINI_EXTRACTION_MIN_VALID_PRODUCT_ROWS=1
GEMINI_EXTRACTION_MAX_OCR_NOISE_PERCENT=30
GEMINI_EXTRACTION_MAX_IDENTITY_FAILURE_PERCENT=20
GEMINI_EXTRACTION_MIN_VALID_NUMERIC_PERCENT=70
# Phase 0: log-only row classifier (default ON; does not change routing)
STOCK_ROW_CLASSIFIER_SHADOW=true
# Phase 1: identity veto (default OFF — enable only after shadow_report + fixtures)
STOCK_IDENTITY_VETO=false
# Comma list; start with image, add scanned_pdf later
STOCK_IDENTITY_VETO_TYPES=image,scanned_pdf
# Phase 2b-2: schema-agnostic Vision table as PRIMARY path (default OFF)
STOCK_VISION_TABLE=false
# Comma list; start with image, add scanned_pdf after probe validation
STOCK_VISION_TABLE_TYPES=image
# Vision-table Gemini output budget (tall sheets truncate at the model default)
STOCK_VISION_MAX_OUTPUT_TOKENS=65535
# Split a single image into two overlapping vertical crops when taller than this
STOCK_VISION_SPLIT_MIN_HEIGHT=2800
# Phase 3a: arithmetic repairs become candidates only (default OFF)
STOCK_NO_REWRITE=false
# Phase 3b: native lanes through shared header resolver (off|shadow|on)
STOCK_NATIVE_RESOLVER=off
# Phase 4a: LibreOffice soffice .doc→.docx on Linux (default OFF)
STOCK_WORD_LINUX=false
# Enforce per-row stock qty identity before Laravel (mark failed, no rewrite)
STOCK_RECONCILIATION_ENFORCE=true
# HTML .xls OP.Stock/Rcpts/CL.Stk: map columns by header labels (default OFF).
# ON fixes optional SL.Value/Free columns shifting CL.Stk/CL.Value to zeros.
STOCK_HTML_EXCEL_OPSTOCK_HEADER_COLMAP=false
# Flutter multi-image stock statement: POST /extract-sales-statement-multi
# (always available; max 10 page images per request, one final statement)

# ---------------------------------------------------------------------------
# Stock OCR benchmark ONLY (does NOT switch production /extract-sales-statement)
# ---------------------------------------------------------------------------
# MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_OCR_TIMEOUT_MS=120000
STOCK_OCR_BENCHMARK_ENABLED=false
