############################################
# split-pdf + split-extract shared environment
#
# Production file: /var/www/html/.env (never commit credentials)
# Copy placeholders only: cp .env.example /var/www/html/.env
############################################

############################################
# Vertex AI Gemini (split-extract)
############################################

GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GEMINI_API_KEY=

# Local Gemini quota manager (AI Studio-era RPM/RPD). Defaults preserve behaviour.
# Under Vertex AI, set USE_LOCAL_GEMINI_RATE_LIMITER=false to rely on provider 429/503.
USE_LOCAL_GEMINI_RATE_LIMITER=false
GEMINI_MAX_REQUESTS_PER_MINUTE=120
GEMINI_MAX_REQUESTS_PER_DAY=10000
GEMINI_PROVIDER_BACKOFF_MAX_SECONDS=60

############################################
# Azure Blob Storage (both services)
############################################

AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string-here
AZURE_STORAGE_ACCOUNT_NAME=your-account-name
AZURE_STORAGE_ACCOUNT_KEY=your-account-key
AZURE_CONTAINER_NAME=invoice-splits

############################################
# split-pdf
############################################

OUTPUT_FOLDER=output_pdfs
ROOT_FOLDER=POD

############################################
# split-extract server
############################################

HOST=0.0.0.0
PORT=8001
MAX_CONCURRENT_REQUESTS=1
REQUEST_QUEUE_TIMEOUT=3600
REQUEST_STUCK_THRESHOLD_SECONDS=1800
MAX_PARALLEL_CALLS=3
MAX_TESSERACT_CONCURRENCY=6

############################################
# Reliability (split-extract — all default off)
#
# Rollout: structured logging → mid-heartbeat → watchdog (600s)
# Do NOT enable OCR_TESSERACT_CALL_TIMEOUT_ENABLED without sign-off.
############################################

OCR_WATCHDOG_ENABLED=false
OCR_WATCHDOG_INTERVAL_SECONDS=30
OCR_WATCHDOG_STUCK_SECONDS=300

OCR_STRUCTURED_LOGGING_ENABLED=false
OCR_SEMAPHORE_LOGGING_ENABLED=false
OCR_THREADPOOL_LOGGING_ENABLED=false
OCR_TESSERACT_LOGGING_ENABLED=false

OCR_TESSERACT_CALL_TIMEOUT_ENABLED=false
TESSERACT_CALL_TIMEOUT_SECONDS=180
OCR_PAGE_FUTURE_TIMEOUT_SECONDS=120

OCR_MID_EXECUTION_HEARTBEAT_ENABLED=false
OCR_HEARTBEAT_TICK_SECONDS=30
