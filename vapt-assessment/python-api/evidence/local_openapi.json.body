{"openapi":"3.1.0","info":{"title":"Invoice Splitter + Extractor API v10.0 (PDFPlumber + Tesseract)","version":"0.1.0"},"paths":{"/split-and-extract":{"post":{"summary":"Split And Extract Invoices","description":"Split and extract invoice data with 4-tier OCR system.\nReturns full raw OCR text in response.","operationId":"split_and_extract_invoices_split_and_extract_post","requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/Body_split_and_extract_invoices_split_and_extract_post"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/test-extract":{"post":{"summary":"Test Extract","description":"Simple test endpoint to directly upload a PDF or image and get extraction output.\nNo blob storage, no queue management - just direct extraction for testing.","operationId":"test_extract_test_extract_post","requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/Body_test_extract_test_extract_post"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/extract-sales-statement":{"post":{"summary":"Extract Sales Statement Endpoint","description":"Extract stock/sales/POD GRN statement data.\n\nReturns the SAME top-level JSON contract as /split-and-extract\n(success, Invoices, invoices, summary, queue, ocr_statistics, ...)\nso Laravel POD screens can treat GRN Excel like other POD uploads.","operationId":"extract_sales_statement_endpoint_extract_sales_statement_post","requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/fastapi___compat__Body_extract_sales_statement_endpoint_extract_sales_statement_post__2"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/extract-pod-grn":{"post":{"summary":"Extract Pod Grn Endpoint","description":"Extract POD GRN / hospital-wise sales Excel into /split-and-extract JSON shape.\n\nAccepts the SAME multipart fields as /split-and-extract so Laravel can reuse\nthe same client payload (file upload OR split_raw_blob_path / split_raw_url).\n\nSecondary sales statements should continue to use /extract-sales-statement.","operationId":"extract_pod_grn_endpoint_extract_pod_grn_post","requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/Body_extract_pod_grn_endpoint_extract_pod_grn_post"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/":{"get":{"summary":"Root","operationId":"root__get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/health":{"get":{"summary":"Health","operationId":"health_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/live":{"get":{"summary":"Live","description":"Non-blocking liveness probe — process is running.","operationId":"live_live_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/ready":{"get":{"summary":"Ready","description":"Non-blocking readiness probe (lightweight resource snapshot).","operationId":"ready_ready_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}}},"components":{"schemas":{"Body_extract_pod_grn_endpoint_e